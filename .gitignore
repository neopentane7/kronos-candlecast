# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Secrets (working rule 4: env vars / Actions secrets only)
.env

# Upstream Kronos is a separate read-only project (working rule 5), reproduced at a
# pinned SHA by phase-a/scripts/setup_upstream.ps1 rather than vendored here.
phase-a/Kronos/

# Corpus archive built for uploading to a cloud runner (see cloud/ and SETUP.md).
# Regenerate from data/ rather than committing it.
kronos-nse-corpus.zip

# Market data + model artifacts are not committed; only manifests and results are.
# Root-anchored on purpose: an unanchored `data/` also matches site/data, which is
# the PWA's committed forecasts and must ship.
/data/
checkpoints/
wandb/
*.pth
*.pt
*.ckpt
*.safetensors

# Eval outputs: keep results.json + figures, drop bulky intermediates.
results/**/*.parquet
results/**/*.npz

# Local agent/harness state and working notes: not part of the published project.
.claude/
CLAUDE.md
PORTFOLIO.md

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# The PWA reads the nightly job's output. It is staged into the build at deploy time
# rather than committed twice under candlecast-web/.
candlecast-web/node_modules/
candlecast-web/dist/
candlecast-web/public/data/
candlecast-web/dev-dist/
candlecast-web/tsconfig.tsbuildinfo

# Staging folder for artifacts pulled off a cloud runner. Everything worth keeping is
# imported into results/ ; this is a scratch copy and duplicates it.
results1/

# kronos-calibrate's worked example is generated, not committed: make_example.py is
# seeded, so the file is reproducible in a second and would otherwise be 4.5 MB of
# binary in every clone.
kronos-calibrate/example_ensembles.npz
